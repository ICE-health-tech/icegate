USDA_API_KEY=

# Agent Configuration
FOOD_AGENT_URL=https://foodagent.icegate.icestore.art
# Screenshot extraction agent (screen memory). Falls back to FOOD_AGENT_URL
# when unset. For local development point this at the stub server:
#   dart run tool/screenshot_agent_stub/server.dart
# AGENT_URL=http://localhost:8123

# Daily email report suggestions (LLM). Falls back to FOOD_AGENT_URL if unset.
MAIL_SUGGESTIONS_AGENT_URL=
MAIL_SUGGESTIONS_TIMEOUT_SEC=25

# n8n finance summary webhook (Canvas → email workflow)
# Default URL when N8N_SUMMARY_HOST is empty, DEFAULT, or PRIMARY:
N8N_SUMMARY_WEBHOOK_URL=https://localn8n.duylong.art/webhook/7705a10d-18cf-4352-9a69-05f9ed94c120
#
# Pick host: value must match suffix N8N_SUMMARY_WEBHOOK_URL_<VALUE> (case-insensitive, e.g. LOCAL, SMALL).
# Same LAN as n8n → use LOCAL with HTTP (Android: cleartext allowed for 192.168.22.4 in network_security_config.xml).
# Remote / HTTPS → use SMALL or leave host unset and set N8N_SUMMARY_WEBHOOK_URL only.
N8N_SUMMARY_HOST=LOCAL
#
N8N_SUMMARY_WEBHOOK_URL_LOCAL=http://192.168.22.4:30109/webhook/7705a10d-18cf-4352-9a69-05f9ed94c120
N8N_SUMMARY_WEBHOOK_URL_SMALL=https://smaln8n.duylong.art/webhook/7705a10d-18cf-4352-9a69-05f9ed94c120
# Easiest extra webhook if other keys are missing from your real .env (comma-separated = try in order after primary chain):
N8N_SUMMARY_WEBHOOK_EXTRAS=https://smaln8n.duylong.art/webhook/7705a10d-18cf-4352-9a69-05f9ed94c120
# Copy BOTH LOCAL and SMALL lines into your real .env, plus N8N_SUMMARY_WEBHOOK_URL above — otherwise you only get 1 URL and no HTTPS fallback after LAN timeout.
# If true (default), failed POST tries other URLs (deduped): primary → LOCAL → SMALL → N8N_SUMMARY_WEBHOOK_URL.
N8N_SUMMARY_TRY_FALLBACK=true
# First attempts use QUICK timeout (default 10s) when multiple URLs exist; last uses TIMEOUT_SEC (default 30).
N8N_SUMMARY_QUICK_ATTEMPT_SEC=10
N8N_SUMMARY_TIMEOUT_SEC=30
# Optional: flutter run --dart-define=N8N_SUMMARY_WEBHOOK_FALLBACK=https://.../webhook/...

N8N_SUMMARY_WEBHOOK_METHOD=POST
N8N_WEBHOOK_SECRET=
